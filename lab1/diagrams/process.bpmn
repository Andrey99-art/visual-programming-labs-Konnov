        <bpmndi:BPMNLabel>
          <dc:Bounds x="1382" y="310" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="1425" y="385" />
        <di:waypoint x="1482" y="385" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="1400" y="265" />
        <di:waypoint x="1450" y="265" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1416" y="247" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="1500" y="225" />
        <di:waypoint x="1500" y="142" />
        <di:waypoint x="1600" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_18_di" bpmnElement="Flow_18">
        <di:waypoint x="1650" y="182" />
        <di:waypoint x="1650" y="632" />
        <di:waypoint x="1750" y="632" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_19_di" bpmnElement="Flow_19">
        <di:waypoint x="1850" y="632" />
        <di:waypoint x="1950" y="632" />
        <di:waypoint x="1950" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_20_di" bpmnElement="Flow_20">
        <di:waypoint x="2000" y="265" />
        <di:waypoint x="2052" y="265" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
