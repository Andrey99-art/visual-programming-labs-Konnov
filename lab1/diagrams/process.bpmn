<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_CreditApplication"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Bank" name="Обработка заявки на кредит" processRef="Process_Credit" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Credit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Client" name="Клиент">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Manager" name="Кредитный менеджер">
        <bpmn:flowNodeRef>Task_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Docs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyReject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareContract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyIssued</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Scoring" name="Скоринговая система">
        <bpmn:flowNodeRef>Task_Score</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Core" name="Банковская система">
        <bpmn:flowNodeRef>Task_CreditHistory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_OpenAccount</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Заявка подана">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Submit" name="Подать заявку на кредит">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Register" name="Зарегистрировать заявку">
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CheckDocs" name="Проверить комплектность документов">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Docs" name="Документы полные?">
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_RequestDocs" name="Запросить недостающие документы">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Split" name="Запуск проверок">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Score" name="Рассчитать кредитный рейтинг">
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_CreditHistory" name="Запросить кредитную историю в БКИ">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_Join" name="Проверки завершены">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_Decision" name="Сформировать решение по заявке">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Решение положительное?">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_NotifyReject" name="Уведомить клиента об отказе">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Reject" name="Отказ">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_PrepareContract" name="Подготовить кредитный договор">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Sign" name="Подписать договор">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_OpenAccount" name="Открыть счёт и перечислить средства">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_NotifyIssued" name="Уведомить клиента о выдаче кредита">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Success" name="Кредит выдан">
      <bpmn:incoming>Flow_20</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_1" targetRef="Task_Submit" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Task_Submit" targetRef="Task_Register" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Task_Register" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Task_CheckDocs" targetRef="Gateway_Docs" />
    <bpmn:sequenceFlow id="Flow_05" name="Да" sourceRef="Gateway_Docs" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_06" name="Нет" sourceRef="Gateway_Docs" targetRef="Task_RequestDocs" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Task_RequestDocs" targetRef="Task_CheckDocs" />
    <bpmn:sequenceFlow id="Flow_08" sourceRef="Gateway_Split" targetRef="Task_Score" />
    <bpmn:sequenceFlow id="Flow_09" sourceRef="Gateway_Split" targetRef="Task_CreditHistory" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Score" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CreditHistory" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Gateway_Join" targetRef="Task_Decision" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Decision" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_14" name="Нет" sourceRef="Gateway_Decision" targetRef="Task_NotifyReject" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_NotifyReject" targetRef="EndEvent_Reject" />
    <bpmn:sequenceFlow id="Flow_16" name="Да" sourceRef="Gateway_Decision" targetRef="Task_PrepareContract" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_PrepareContract" targetRef="Task_Sign" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Sign" targetRef="Task_OpenAccount" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_OpenAccount" targetRef="Task_NotifyIssued" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_NotifyIssued" targetRef="EndEvent_Success" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Bank_di" bpmnElement="Participant_Bank" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1990" height="615" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1960" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Manager_di" bpmnElement="Lane_Manager" isHorizontal="true">
        <dc:Bounds x="190" y="205" width="1960" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Scoring_di" bpmnElement="Lane_Scoring" isHorizontal="true">
        <dc:Bounds x="190" y="445" width="1960" height="125" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Core_di" bpmnElement="Lane_Core" isHorizontal="true">
        <dc:Bounds x="190" y="570" width="1960" height="125" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="232" y="124" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="215" y="167" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submit_di" bpmnElement="Task_Submit">
        <dc:Bounds x="300" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Sign_di" bpmnElement="Task_Sign">
        <dc:Bounds x="1600" y="102" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Register_di" bpmnElement="Task_Register">
        <dc:Bounds x="450" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckDocs_di" bpmnElement="Task_CheckDocs">
        <dc:Bounds x="600" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Docs_di" bpmnElement="Gateway_Docs" isMarkerVisible="true">
        <dc:Bounds x="750" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="735" y="212" width="81" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RequestDocs_di" bpmnElement="Task_RequestDocs">
        <dc:Bounds x="600" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Split_di" bpmnElement="Gateway_Split">
        <dc:Bounds x="850" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="843" y="212" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Score_di" bpmnElement="Task_Score">
        <dc:Bounds x="950" y="467" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CreditHistory_di" bpmnElement="Task_CreditHistory">
        <dc:Bounds x="950" y="592" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Join_di" bpmnElement="Gateway_Join">
        <dc:Bounds x="1100" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1088" y="212" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Decision_di" bpmnElement="Task_Decision">
        <dc:Bounds x="1200" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Decision_di" bpmnElement="Gateway_Decision" isMarkerVisible="true">
        <dc:Bounds x="1350" y="240" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1334" y="212" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyReject_di" bpmnElement="Task_NotifyReject">
        <dc:Bounds x="1325" y="345" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Reject_di" bpmnElement="EndEvent_Reject">
        <dc:Bounds x="1482" y="367" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1485" y="410" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PrepareContract_di" bpmnElement="Task_PrepareContract">
        <dc:Bounds x="1450" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenAccount_di" bpmnElement="Task_OpenAccount">
        <dc:Bounds x="1750" y="592" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyIssued_di" bpmnElement="Task_NotifyIssued">
        <dc:Bounds x="1900" y="225" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success">
        <dc:Bounds x="2052" y="247" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2035" y="290" width="71" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="268" y="142" />
        <di:waypoint x="300" y="142" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="350" y="182" />
        <di:waypoint x="350" y="265" />
        <di:waypoint x="450" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="550" y="265" />
        <di:waypoint x="600" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_di" bpmnElement="Flow_04">
        <di:waypoint x="700" y="265" />
        <di:waypoint x="750" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="800" y="265" />
        <di:waypoint x="850" y="265" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="816" y="247" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="775" y="290" />
        <di:waypoint x="775" y="385" />
        <di:waypoint x="700" y="385" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="782" y="320" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_di" bpmnElement="Flow_07">
        <di:waypoint x="650" y="345" />
        <di:waypoint x="650" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="875" y="290" />
        <di:waypoint x="875" y="507" />
        <di:waypoint x="950" y="507" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="875" y="290" />
        <di:waypoint x="875" y="632" />
        <di:waypoint x="950" y="632" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1050" y="507" />
        <di:waypoint x="1125" y="507" />
        <di:waypoint x="1125" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1050" y="632" />
        <di:waypoint x="1125" y="632" />
        <di:waypoint x="1125" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1150" y="265" />
        <di:waypoint x="1200" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="1300" y="265" />
        <di:waypoint x="1350" y="265" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1375" y="290" />
