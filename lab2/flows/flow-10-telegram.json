        "func": "// echo: отвечаем на любое текстовое сообщение (команды сюда не попадают: включён Filter commands)\nconst p = msg.payload;\nlet text;\n\nif (p.type === \"message\" && typeof p.content === \"string\") {\n    text = \"Konnov SDP-241 echo: \" + p.content;\n} else {\n    text = \"Я умею отвечать эхом только на текст (получен тип: \" + p.type + \")\";\n}\n\nreturn { payload: { chatId: p.chatId, type: \"message\", content: text } };\n",
