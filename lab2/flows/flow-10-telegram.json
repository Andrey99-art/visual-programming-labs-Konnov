        "func": "// /time: текущее время сервера в часовом поясе Минска\nconst TIME_ZONE = \"Europe/Minsk\";\nconst p = msg.payload;\nconst now = new Date().toLocaleString(\"ru-RU\", { timeZone: TIME_ZONE });\n\nreturn {\n    payload: {\n        chatId: p.chatId,\n        type: \"message\",\n        content: \"Сейчас (\" + TIME_ZONE + \"): \" + now\n    }\n};\n",
