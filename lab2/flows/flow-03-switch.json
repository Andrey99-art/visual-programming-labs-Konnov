    {
        "id": "k03function00001",
        "type": "function",
        "z": "k03tab0000000001",
        "name": "Konnov: статистика оценок",
        "func": "// Лаб. 2, п. 2.2. Коннов, СДП-241 ИИ: статистика по оценкам студента\nconst PASS_AVERAGE = 6; // порог \"зачёта\" по среднему баллу\n\nconst input = msg.payload;\nconst scores = Array.isArray(input.scores) ? input.scores : [];\n\nlet sum = 0;\nlet count = 0;\nlet max = null;\nconst bad = []; // сюда складываем значения, которые не число\n\nfor (let i = 0; i < scores.length; i++) {\n    const value = Number(scores[i]);\n    if (Number.isNaN(value)) {\n        bad.push(scores[i]);\n        continue;\n    }\n    sum += value;\n    count++;\n    if (max === null || value > max) {\n        max = value;\n    }\n}\n\nlet average = 0;\nlet verdict;\nif (count === 0) {\n    verdict = \"нет данных\";\n} else {\n    average = Math.round((sum / count) * 100) / 100;\n    if (average >= PASS_AVERAGE) {\n        verdict = \"зачёт\";\n    } else {\n        verdict = \"не зачёт\";\n    }\n}\n\nconst result = {\n    student: input.name + \" \" + input.group,\n    count: count,\n    sum: sum,\n    max: max,\n    average: average,\n    verdict: verdict,\n    passed: verdict === \"зачёт\",\n    ignored: bad\n};\n\nreturn { payload: result, topic: msg.topic };\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
