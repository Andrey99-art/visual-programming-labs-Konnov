        "id": "k11funcbuild0001",
        "type": "function",
        "z": "k11tab0000000001",
        "name": "Konnov: строка записи + счётчик",
        "func": "// Лаб. 2, п. 2.11. Коннов, СДП-241 ИИ: формируем строку записи для лог-файла\nconst STUDENT = \"Konnov\";\nconst GROUP = \"SDP-241\";\n\nconst now = new Date();\nconst record = {\n    ts: now.toISOString(),\n    student: STUDENT,\n    group: GROUP,\n    counter: 0\n};\n\n// счётчик хранится в flow context, чтобы в файле были разные строки при каждом нажатии\nlet counter = flow.get(\"fileWriteCounter\");\nif (typeof counter !== \"number\") {\n    counter = 0;\n}\ncounter = counter + 1;\nflow.set(\"fileWriteCounter\", counter);\nrecord.counter = counter;\n\nlet line = \"\";\nfor (const key in record) {\n    if (line !== \"\") {\n        line += \";\";\n    }\n    line += key + \"=\" + record[key];\n}\n\nmsg.payload = line + \"\\n\";\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
